# .env.example — environment configuration template for dicta2stream backend
# Copy this file to .env and fill in your actual values

# Debug mode (0 for production, 1 for development)
DEBUG=0

# Secret key for admin endpoints (generate a strong random string)
ADMIN_SECRET=your_admin_secret_here

# Database connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/dictastream

# Domain for the application (used in emails, etc.)
DOMAIN=dicta2stream.net

# Other optional settings
# CORS_ORIGINS=https://dicta2stream.net
# MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
